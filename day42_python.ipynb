        "#Operators, Conditional Statements\n",
        "#If n is odd, print Weird\n",
        "n=int(input(\"Enter a number:   \"))\n",
        "if   n%2!=0:\n",
        "     print(\"weird\")\n",
        "elif n>=2 and n<=5:\n",
        "     print(\"not weird\")\n",
        "elif n>=6 and n<=20:\n",
        "     print(\"weird\")\n",
        "else:\n",
        "     print(\"not weird\")\n",
        "\n"
